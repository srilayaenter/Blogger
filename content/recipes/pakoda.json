  "instructions": [
    {
      "id": "pakoda-instruction-1",
      "step_number": 1,
      "instruction_ta": "ஒரு தாம்பாளத்தில் வெட்டிய வெங்காயம், மிளகாய், பூண்டு, இஞ்சி, நெய், எண்ணெய், உப்பு, சோடா உப்பு, போட்டு நுரைக்கத் தேய்த்து, பின் இரண்டு மாவு, முந்திரிப்பருப்பு போட்டு சிறு தண்ணீர் சேர்த்துத் தேய்த்து, கெட்டியாகப் பிசைந்து, எண்ணெயில் உதிர்த்து விட்டு சிவக்க வெந்ததும் எடுக்கவும்.",
      "instruction_en": "Oru thaambaaLathil vettiya vengayam, milagai, poondu, inji, nei, ennai, uppu, soda uppu, pottu nuraikkath theyithu, pin irandu maavu, mundhiri paruppu pottu siRu thanneer serthuth theyithu, kettiyaagap pisainthu, ennaiyil udhirthu vittu sivakka venthathum edukkavum.",
      "image_url": null,
      "display_order": 1
    }
  ]
}
