  "instructions": [
    {
      "id": "javvarisi-payasam-instruction-1",
      "step_number": 1,
      "instruction_ta": "அடுப்பில் கொதிக்கும் வெந்நீர் வைத்து, அதில் ஜவ்வரிசியைப் போட்டு கைவிடாமல் கிளறவும். ஜவ்வரிசி வெந்ததும் வெல்லம் சேர்க்கவும். பாயசம், பாகு வாசனை வந்ததும் அடுப்பில் இருந்து இறக்கி, தேங்காய்ப் பாலை அதில் சேர்த்துக் கிளறவும். நெய்யில் முந்திரி, ஏலக்காய் வறுத்து பாயசத்தில் போடவும். சூடாக பரிமாறவும்.",
      "instruction_en": "Bring water to a boil, add the sago, and stir continuously without stopping. Once the sago is cooked, add the jaggery. When the payasam develops a syrupy aroma, remove from heat and stir in the coconut milk. Fry the cashew nuts and cardamom in ghee and add to the payasam. Serve hot.",
      "image_url": null,
      "display_order": 1
    }
  ]
