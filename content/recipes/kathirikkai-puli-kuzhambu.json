  "instructions": [
    {
      "id": "kathirikkai-puli-kuzhambu-instruction-1",
      "step_number": 1,
      "instruction_ta": "¼ கிலோ கத்திரிக்காயை நீளமாக வெட்டி வைக்கவும். குக்கரில் 4 கரண்டி எண்ணெய் ஊற்றி கடுகு உளுந்தம்பருப்பு போட்டு சிவந்ததும் வெட்டிய வெங்காயம் 6, கீறிய மிளகாய் 2, உரித்த பூண்டு 10 பல், கருவேப்பிலை போட்டு வதங்கியதும் கத்திரிக்காயை கழுவிப்போட்டு அரைத்த மசால், உப்பு, மஞ்சள் போட்டு சிறிது நேரம் தண்ணீரில் வேக வைத்து 2 சில தேங்காய் அரைத்து பால் எடுத்து ஊற்றி குக்கரை மூடி 5 நிமிஷம் வைத்திருந்து பின் திறந்து, சிறிய எலுமிச்சம்பழ அளவு புளியை நனைய வைத்து கரைத்து ஊற்றி குழம்பு நன்றாக கொதித்து கத்திரிக்காய் வெந்தது பார்த்து எண்ணெய் தெளிய இறக்கவும்.",
      "instruction_en": "1/4 kilo kathirikkaiyai neeLamaaga vetti vaikkavum. Cooker-il 4 karandi ennai oorRi kadugu ulundham paruppu pottu sivanthathum vettiya vengayam 6, keeRiya milagai 2, uriththa poondu 10 pal, karuvepilai pottu vathangiyathum kathirikkaiyai kazhuvip pottu araitha masaal, uppu, manjal pottu siRithu neram thanneeril vega vaithu 2 sila thengai araithu paal eduthu oorRi cooker-ai moodi 5 nimisham vaithirunthu pin thiRanthu, siRiya elumichampazha aLavu puliyai naNaiya vaithu karaithu oorRi kuzhambu nanRaaga kothithu kathirikkai venthathu paarthu ennai theliya irakkavum.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "kathirikkai-puli-kuzhambu-instruction-2",
      "step_number": 2,
      "instruction_ta": "1) ½ கிலோ கத்திரிக்காய்க்கு 2 முருங்கைக்காயும் 1 தக்காளிப் பழம் சேர்த்து குழம்பு வைக்கலாம். 2) 100 கத்திரிக்காய் 100 பாகற்காய் சேர்த்து புளிக்குழம்பு வைக்கலாம்.",
      "instruction_en": "1) 1/2 kilo kathirikkaikku 2 murungaikkaaiyum 1 thakkaalip pazham serthu kuzhambu vaikkalaam. 2) 100 kathirikkai 100 pagarkai serthu puli kuzhambu vaikkalaam.",
      "image_url": null,
      "display_order": 2
    }
  ]
