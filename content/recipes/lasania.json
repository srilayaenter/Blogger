  "instructions": [
    {
      "id": "lasania-instruction-1",
      "step_number": 1,
      "instruction_ta": "உருளைக்கிழங்கை கமாராண அளவுள்ள ஒரே மாதிரி சைசில் வாங்கவும்.",
      "instruction_en": "Buy potatoes of similar, moderate size.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "lasania-instruction-2",
      "step_number": 2,
      "instruction_ta": "குக்கரில் வேக வைத்து தோலுரிக்கவும்.",
      "instruction_en": "Pressure-cook and peel.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "lasania-instruction-3",
      "step_number": 3,
      "instruction_ta": "கூரான கத்தியால் மேலிருந்து முக்கால் பாகம்வரை இறங்கும்படி அறுக்கவும்.",
      "instruction_en": "Slice from the top down about three-quarters of the way through with a sharp knife.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "lasania-instruction-4",
      "step_number": 4,
      "instruction_ta": "அரைத்த விழுதில் சிறிதளவு அதன் மத்தியில் பூசவும்.",
      "instruction_en": "Smear a little of the ground paste into the middle of the slit.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "lasania-instruction-5",
      "step_number": 5,
      "instruction_ta": "கடலை மாவோடு மஞ்சள் தூள், தனியாப் பொடி, உப்பு, மிளகாய்த் தூள், சமையல் சோடா சேர்த்து தண்ணீர் விட்டுப் பிசைந்து பஜ்ஜி மாவு தயாரிக்கவும்.",
      "instruction_en": "Mix turmeric powder, coriander powder, salt, chili powder, and cooking soda into the gram flour, add water, and knead into a bajji batter.",
      "image_url": null,
      "display_order": 5
    },
    {
      "id": "lasania-instruction-6",
      "step_number": 6,
      "instruction_ta": "தயாரித்த உருளைக்கிழங்கை இந்த மாவில் தோய்த்து சூடான எண்ணெயில் பொரிக்கவும்.",
      "instruction_en": "Dip the prepared potatoes in this batter and deep-fry in hot oil.",
      "image_url": null,
      "display_order": 6
    },
    {
      "id": "lasania-instruction-7",
      "step_number": 7,
      "instruction_ta": "கவனிக்க: சிறு உருளைக்கிழங்கை வாங்கி உபயோகப்படுத்தினால் இந்த பஜ்ஜி நன்றாக இருக்கும்.",
      "instruction_en": "Note: this bajji turns out best when made with small potatoes.",
      "image_url": null,
      "display_order": 7
    }
  ]
}
