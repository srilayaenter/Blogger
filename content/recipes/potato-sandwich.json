  "instructions": [
    {
      "id": "potato-sandwich-instruction-1",
      "step_number": 1,
      "instruction_ta": "உருளைக்கிழங்கை வேக வைத்து, தோலுரித்து உதிரியாக்கவும்.",
      "instruction_en": "Boil the potato, peel, and crumble.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "potato-sandwich-instruction-2",
      "step_number": 2,
      "instruction_ta": "வெங்காயம், பச்சை மிளகாயை மிகப் பொடியாக அரியவும்.",
      "instruction_en": "Finely chop the onion and green chili.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "potato-sandwich-instruction-3",
      "step_number": 3,
      "instruction_ta": "வாணலியில் சிறிது எண்ணெய் விட்டுச் சூடாக்கி, பச்சை மிளகாய் மற்றும் வெங்காயத்தைப் போட்டு பொன்னிறமாகும் வரை வதக்கவும்.",
      "instruction_en": "Heat a little oil in a pan, add the green chili and onion, and saute until golden.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "potato-sandwich-instruction-4",
      "step_number": 4,
      "instruction_ta": "இதில் மிளகாய்ப் பொடி, மஞ்சள் தூள், கரம்மசாலாத் தூள் சேர்த்து ஒரு வினாடி கலந்தபின் உருளைக்கிழங்கைச் சேர்த்து சில நிமிடங்கள் கலக்கவும்.",
      "instruction_en": "Add the chili powder, turmeric powder, and garam masala powder, mix for a moment, then add the potato and stir for a few minutes.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "potato-sandwich-instruction-5",
      "step_number": 5,
      "instruction_ta": "கடைசியில் உப்பு சேர்த்து கீழே இறக்கி கொத்தமல்லித் தழை சேர்த்து கலந்து ஆற விடவும்.",
      "instruction_en": "Finally add salt, remove from heat, mix in the coriander leaves, and let it cool.",
      "image_url": null,
      "display_order": 5
    },
    {
      "id": "potato-sandwich-instruction-6",
      "step_number": 6,
      "instruction_ta": "கடலை மாவை சிறிது நெய் விட்டு வாணலியில் நல்ல வாசனை வரும்வரை சில நிமிடங்கள் குறைந்த தணலில் கலக்கவும்.",
      "instruction_en": "Heat the gram flour with a little ghee in a pan and stir over low heat for a few minutes until fragrant.",
      "image_url": null,
      "display_order": 6
    },
    {
      "id": "potato-sandwich-instruction-7",
      "step_number": 7,
      "instruction_ta": "இதை உருளைக்கிழங்கு கலவையோடு சேர்த்துக் கலந்துவிடவும்.",
      "instruction_en": "Mix this into the potato mixture.",
      "image_url": null,
      "display_order": 7
    },
    {
      "id": "potato-sandwich-instruction-8",
      "step_number": 8,
      "instruction_ta": "வெண்ணெய் தடவிய ரொட்டித் துண்டின் ஒரு பாகத்தில் இக் கலவையில் சிறிது பரப்பி நைசான பிரட் தூளை மேலே தூவி கைகளால் லேசாக அமுக்கி விடவும். ரொட்டியின் இருபுறமும் எண்ணெய் விட்டு சிவக்கக் கல்லில் சுட்டு எடுக்கவும். தக்காளி சாஸ் / 'கெட்ச்அப்'புடன் பரிமாறவும்.",
      "instruction_en": "Spread a little of this mixture on one buttered bread slice, sprinkle fine bread crumbs on top, and press lightly by hand. Toast both sides on an oiled griddle until browned. Serve with tomato sauce/ketchup.",
      "image_url": null,
      "display_order": 8
    }
  ]
}
