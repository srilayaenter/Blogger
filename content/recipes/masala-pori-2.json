  "instructions": [
    {
      "id": "masala-pori-2-instruction-1",
      "step_number": 1,
      "instruction_ta": "அரிந்த சிறிய வெங்காயத்தோடு உப்பு, மிளகாய்த் தூள் சேர்த்து எலுமிச்சம் பழம் பிழிந்து 1 மணி நேரம் ஊற வைக்கவும்.",
      "instruction_en": "Mix the chopped shallots with salt and chili powder, squeeze in the lemon juice, and let it sit for 1 hour.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "masala-pori-2-instruction-2",
      "step_number": 2,
      "instruction_ta": "சட்னியை சிறிதளவே தண்ணீர் சேர்த்து கெட்டியாக அரைத்து 1/2 மணி நேரம் ப்ரிஜ்ஜில் வைக்கவும்.",
      "instruction_en": "Grind the chutney with just a little water into a thick paste and refrigerate for 1/2 hour.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "masala-pori-2-instruction-3",
      "step_number": 3,
      "instruction_ta": "பொட்டுக்கடலையையும், வேர்க்கடலையையும் பொரியோடு சேர்த்து ஒரு டேபிள் ஸ்பூன் எண்ணெய் விட்டு கைகளால் நன்கு கலந்துவிடவும்.",
      "instruction_en": "Mix the roasted gram and groundnuts with the puffed rice, add one tablespoon of oil, and mix well by hand.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "masala-pori-2-instruction-4",
      "step_number": 4,
      "instruction_ta": "தேவைப்படும் அளவு சட்னியையும், ஊறவைத்த வெங்காயம், எலுமிச்சை ரசத்தோடு இதில் சேர்த்துக் கலந்து உப்பு, மிளகாய்த் தூள் பற்றாவிடில் தூவி கலந்து உடனே பரிமாறவும்.",
      "instruction_en": "Mix in as much of the chutney as needed, along with the marinated onion and its lemon juice, add more salt and chili powder if it's not enough, mix, and serve immediately.",
      "image_url": null,
      "display_order": 4
    }
  ]
