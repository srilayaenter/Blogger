  "instructions": [
    {
      "id": "double-beans-rissoles-instruction-1",
      "step_number": 1,
      "instruction_ta": "டபுள் பீன்ஸ் விதைகளை தண்ணீரில் முதல் நாளே ஊற வைக்கவும் (20 லிருந்து 24 மணி நேரம்). தண்ணீரை வடித்துவிட்டு, பிதுக்கி மேல் தோலை எடுக்கவும்.",
      "instruction_en": "Soak the double beans in water the day before, for 20 to 24 hours. Drain, then squeeze off and discard the outer skins.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "double-beans-rissoles-instruction-2",
      "step_number": 2,
      "instruction_ta": "தண்ணீர் சேர்க்காமல் கெட்டியாக உளுந்து மாவு போல அரைக்கவும். கடைசியில் உப்பு, அரைத்த மிளகாய் விழுது சேர்க்கவும்.",
      "instruction_en": "Grind without adding water into a thick paste, like urad dal batter. Add salt and the ground chili paste at the end.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "double-beans-rissoles-instruction-3",
      "step_number": 3,
      "instruction_ta": "இதோடு நறுக்கிய வெங்காயம், வெங்காயத் தாள், தனியா சீரகப் பொடி சேர்த்து கலக்கவும். சிறு சிறு உருண்டைகளாக உருட்டி எண்ணெயில் பொரித்து சூடாகப் பரிமாறவும்.",
      "instruction_en": "Mix in the chopped onion, spring onion greens, and coriander-cumin powder. Shape into small balls and deep-fry in oil, then serve hot.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "double-beans-rissoles-instruction-4",
      "step_number": 4,
      "instruction_ta": "குறிப்பு: இதை சுண்டலுக்காக உபயோகப்படுத்தும் காய்ந்த பீன்சை உபயோகப்படுத்தி செய்யவும்.",
      "instruction_en": "Note: use the same dried double beans normally used for making sundal to prepare this.",
      "image_url": null,
      "display_order": 4
    }
  ]
