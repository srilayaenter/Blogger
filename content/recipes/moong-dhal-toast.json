  "instructions": [
    {
      "id": "moong-dhal-toast-instruction-1",
      "step_number": 1,
      "instruction_ta": "பச்சை மிளகாய், கொத்தமல்லித் தழை, எலுமிச்சம் சாறு (அ) மாங்காய்த் துண்டு, சீரகம், உப்பு, சர்க்கரை சேர்த்து சட்னியாக அரைக்கவும்.",
      "instruction_en": "Grind the green chili, coriander leaves, lemon juice or raw mango, cumin, salt, and sugar into a chutney.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "moong-dhal-toast-instruction-2",
      "step_number": 2,
      "instruction_ta": "ஊறவைத்த பயத்தம் பருப்போடு சோம்பு, இஞ்சி, பச்சை மிளகாய், மிளகாய்ப் பொடி, உப்பு சேர்த்து கரகரப்பாக அரைத்துக் கொள்ளவும்.",
      "instruction_en": "Grind the soaked moong dal together with the fennel, ginger, green chili, chili powder, and salt into a coarse paste.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "moong-dhal-toast-instruction-3",
      "step_number": 3,
      "instruction_ta": "ரொட்டித் துண்டுகளின் இருபுறமும் வெண்ணெய் தடவவும்.",
      "instruction_en": "Butter both sides of the bread slices.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "moong-dhal-toast-instruction-4",
      "step_number": 4,
      "instruction_ta": "ஒரு பக்கம் வெண்ணெயின் மேல் சட்னியைத் தடவி அதன்மேல் சிறிதளவு பயத்தம் பருப்பு விழுதைப் பூசவும்.",
      "instruction_en": "On one buttered side, spread the chutney, then spread a little of the moong dal paste over it.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "moong-dhal-toast-instruction-5",
      "step_number": 5,
      "instruction_ta": "வாணலி அல்லது ஒரு சிறிய அகலமான பானில் (Pan) எண்ணெய் விட்டுச் சூடாக்கி பருப்பு பூசிய பாகம் கீழே எண்ணெயில் முதலில் இருக்கும்படி ரொட்டித் துண்டைப் போட்டு பொரிக்கவும்.",
      "instruction_en": "Heat oil in a pan or a small, wide skillet, and place the bread slice dal-spread-side down first into the oil, and fry.",
      "image_url": null,
      "display_order": 5
    },
    {
      "id": "moong-dhal-toast-instruction-6",
      "step_number": 6,
      "instruction_ta": "கீழ்ப்பாகம் சிவக்க வெந்ததும் திருப்பிப் போட்டு பொன்னிறமாக ரொட்டி பொரிந்ததும் எடுத்து எண்ணெயை நன்றாக வடியவிட்டு சூடாக தக்காளி சாஸுடன் பரிமாறவும்.",
      "instruction_en": "Once the bottom is browned and cooked, flip and once golden, remove, drain the oil well, and serve hot with tomato sauce.",
      "image_url": null,
      "display_order": 6
    }
  ]
}
