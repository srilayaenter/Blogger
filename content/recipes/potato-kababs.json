  "instructions": [
    {
      "id": "potato-kababs-instruction-1",
      "step_number": 1,
      "instruction_ta": "உருளைக்கிழங்கை வேகவைத்து தோலுரித்து நன்றாக மசித்துக் கொள்ளவும்.",
      "instruction_en": "Boil the potatoes, peel, and mash thoroughly.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "potato-kababs-instruction-2",
      "step_number": 2,
      "instruction_ta": "ரொட்டித் துண்டங்களை ஒவ்வொன்றாகத் தண்ணீரில் முக்கி உடனே எடுத்து நன்றாகப் பிழிந்து உருளைக்கிழங்குடன் சேர்க்கவும்.",
      "instruction_en": "Dip each bread slice in water, remove immediately, squeeze out thoroughly, and mix into the mashed potato.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "potato-kababs-instruction-3",
      "step_number": 3,
      "instruction_ta": "மற்ற பொருட்களைச் சேர்த்துக் கலக்கவும். சிறிய உருண்டைகளாக்கி நீளவாக்கில் உருட்டவும்.",
      "instruction_en": "Mix in the rest of the ingredients. Shape into small balls and roll each into an oblong log.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "potato-kababs-instruction-4",
      "step_number": 4,
      "instruction_ta": "சூடான எண்ணெயில் பொன்னிறமாகப் பொரித்து சாஸ் அல்லது புதினா சட்னியுடன் பரிமாறவும்.",
      "instruction_en": "Deep-fry in hot oil until golden and serve with sauce or mint chutney.",
      "image_url": null,
      "display_order": 4
    }
  ]
