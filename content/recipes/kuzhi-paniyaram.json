  "instructions": [
    {
      "id": "kuzhi-paniyaram-instruction-1",
      "step_number": 1,
      "instruction_ta": "அரிசி உளுந்தம்பருப்பு, வெந்தயம் எல்லாவற்றையும் ஒன்றாக நனைய வைத்து, இரவு தோசை மாவு போல் ஆட்டி வைக்கவும். காலையில் தேங்காய்ப்பூ கலந்து குழிப்பணியாரம் சட்டியில் ஊற்றி வைக்கவும்.",
      "instruction_en": "Arisi ulundham paruppu, venthayam ellaavatRaiyum onRaaga naNaiya vaithu, iravu thosai maavu pol aatti vaikkavum. Kaalaiyil thengaippoo kalanthu kuzhippaniyaaram sattiyil oorRi vaikkavum.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "kuzhi-paniyaram-instruction-2",
      "step_number": 2,
      "instruction_ta": "குறிப்பு: கருப்பட்டி கலந்தும் சுடலாம்.",
      "instruction_en": "KuRippu: Karuppatti kalanthum sudalaam.",
      "image_url": null,
      "display_order": 2
    }
  ]
