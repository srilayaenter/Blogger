  "instructions": [
    {
      "id": "corn-sandwich-instruction-1",
      "step_number": 1,
      "instruction_ta": "மக்காச்சோளத்தை குக்கரில் தண்ணீரில் போட்டு வேக வைத்து, ஆறியபின் விதைகளை உதிர்த்து எடுக்கவும்.",
      "instruction_en": "Pressure-cook the corn in water, and once cooled, strip off the kernels.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "corn-sandwich-instruction-2",
      "step_number": 2,
      "instruction_ta": "வாணலியில் சிறிது எண்ணெய் விட்டுச் சூடாக்கி சீரகம் தாளித்து, பச்சை மிளகாய் மற்றும் வெங்காயத்தைச் சேர்த்து 2 நிமிடங்கள் வதக்கவும்.",
      "instruction_en": "Heat a little oil in a pan, temper cumin, add the green chili and onion, and saute for 2 minutes.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "corn-sandwich-instruction-3",
      "step_number": 3,
      "instruction_ta": "வெங்காயம் வதங்கியதும் வெங்காயத் தாள், வேக வைத்த சோள விதைகள், சீன உப்பு சேர்த்து சில நிமிடங்கள் வதக்கவும்.",
      "instruction_en": "Once the onion has wilted, add the spring onion greens, the cooked corn kernels, and the ajinomoto, and saute for a few minutes.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "corn-sandwich-instruction-4",
      "step_number": 4,
      "instruction_ta": "கடைசியில் உப்பு, மிளகுத்தூள், புதினாத் தழை, கடுகுப் பொடி கலந்து இறக்கவும்.",
      "instruction_en": "Finally mix in salt, pepper powder, mint leaves, and mustard powder, and remove from heat.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "corn-sandwich-instruction-5",
      "step_number": 5,
      "instruction_ta": "ஆறியதும் கடைந்த பாலேடு சேர்த்து கலக்கவும்.",
      "instruction_en": "Once cooled, mix in the whipped cream.",
      "image_url": null,
      "display_order": 5
    },
    {
      "id": "corn-sandwich-instruction-6",
      "step_number": 6,
      "instruction_ta": "வெண்ணெய் தடவிய ரொட்டித் துண்டின் மேல் இக் கலவையில் சிறிது பரப்பி அதன்மேல் துருவிய சீஸை வைத்து சூடாக்கிய ஓவனில் சில நிமிடங்கள் வைத்து லேசாக நிறம் மாறியதும் பரிமாறவும்.",
      "instruction_en": "Spread a little of this mixture on a buttered bread slice, top with grated cheese, and place in a preheated oven for a few minutes; serve once it just changes color.",
      "image_url": null,
      "display_order": 6
    }
  ]
}
