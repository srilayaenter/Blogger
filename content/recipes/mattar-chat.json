  "instructions": [
    {
      "id": "mattar-chat-instruction-1",
      "step_number": 1,
      "instruction_ta": "ஒரு வாணலியில் சிறிது எண்ணெய் விட்டுச் சூடாக்கி சீரகம் தாளித்து நீளவாக்கில் அரிந்த பச்சை மிளகாய் சேர்த்து உரித்த பட்டாணி சேர்த்து ஒரு நிமிடம் கலக்கவும்.",
      "instruction_en": "Heat a little oil in a pan, temper cumin, add the lengthwise-sliced green chili, then add the shelled peas and mix for one minute.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "mattar-chat-instruction-2",
      "step_number": 2,
      "instruction_ta": "சிறிது தண்ணீர் தெளித்து மூடியால் மூடி பட்டாணி நன்கு வேகும்வரை குறைந்த தணலில் வைக்கவும்.",
      "instruction_en": "Sprinkle in a little water, cover with a lid, and cook on low heat until the peas are well done.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "mattar-chat-instruction-3",
      "step_number": 3,
      "instruction_ta": "அவ்வப்போது நன்கு கிளறி விட்டு பட்டாணி வெந்து தண்ணீர் வற்றியதும் பொடி வகைகளைச் சேர்த்து கலக்கவும்.",
      "instruction_en": "Stir occasionally, and once the peas are cooked and the water has dried up, mix in the powdered spices.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "mattar-chat-instruction-4",
      "step_number": 4,
      "instruction_ta": "நன்றாகக் கலந்து அடுப்பிலிருந்து இறக்கி ஒரு பரிமாறும் தட்டில் மாற்றவும்.",
      "instruction_en": "Mix well, remove from heat, and transfer to a serving plate.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "mattar-chat-instruction-5",
      "step_number": 5,
      "instruction_ta": "பானி பூரி துண்டுகளை அதன் மேல் தூவி, அரிந்த வெங்காயம் அலங்கரித்து கடைந்த தயிரை ஊற்றவும்.",
      "instruction_en": "Sprinkle the pani puri pieces on top, garnish with chopped onion, and pour the whisked curd over it.",
      "image_url": null,
      "display_order": 5
    },
    {
      "id": "mattar-chat-instruction-6",
      "step_number": 6,
      "instruction_ta": "அதற்கும் மேலே இனிப்பு சட்னியை ஊற்றி ஓமப் பொடியை மேலே அலங்கரித்து உடனே பரிமாறவும்.",
      "instruction_en": "Pour the sweet chutney over that too, garnish with sev on top, and serve immediately.",
      "image_url": null,
      "display_order": 6
    }
  ]
}
