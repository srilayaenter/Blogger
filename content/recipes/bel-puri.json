  "instructions": [
    {
      "id": "bel-puri-instruction-1",
      "step_number": 1,
      "instruction_ta": "பூண்டு சட்னி: பூண்டு, ஊற வைத்த புளி, சீரகம், மிளகாய்ப் பொடி, உப்பு ஆகியவற்றை நன்றாக அரைத்துக் கொள்ளவும்.",
      "instruction_en": "Garlic chutney: Grind the garlic, soaked tamarind, cumin, chili powder, and salt together into a smooth chutney.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "bel-puri-instruction-2",
      "step_number": 2,
      "instruction_ta": "ஒரு அகலமான பேசினில் நொறுக்கிய பூரிகள், சிப்ஸ், பொரி, பாதி ஓமப்பொடி சேர்த்து கலக்கவும்.",
      "instruction_en": "In a wide basin, mix the crushed puris, potato chips, puffed rice, and half of the sev.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "bel-puri-instruction-3",
      "step_number": 3,
      "instruction_ta": "குறிப்பிடப்பட்ட அரிந்த காய்கறிகளை சேர்த்து பொடி வகைகளைத் தூவவும்.",
      "instruction_en": "Add the chopped vegetables listed above and dust in the powdered spices.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "bel-puri-instruction-4",
      "step_number": 4,
      "instruction_ta": "கடைசியில் சட்னி வகைகளை, விருப்பத்திற்கேற்ப சேர்த்து வேகமாக கலந்து உடனே பரிமாறவும். பரிமாறும் போது மேலே பொடியாக நறுக்கிய வெங்காயம், கொத்தமல்லித் தழை, ஓமப்பொடி தூவி பரிமாறவும். (குறிப்பு: மெல்லிய பாம்பே ஓமப்பொடியை உபயோகப்படுத்தினால் தான் ருசி நன்றாக இருக்கும்.)",
      "instruction_en": "Finally, add the chutneys to taste, toss quickly, and serve immediately. When serving, sprinkle finely chopped onion, coriander leaves, and sev on top. (Note: it tastes best made with fine Bombay-style sev.)",
      "image_url": null,
      "display_order": 4
    }
  ]
}
