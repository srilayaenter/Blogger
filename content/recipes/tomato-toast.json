  "instructions": [
    {
      "id": "tomato-toast-instruction-1",
      "step_number": 1,
      "instruction_ta": "ரொட்டித் துண்டின் இரு பக்கமும் நெய் தடவவும்.",
      "instruction_en": "Butter both sides of the bread slices with ghee.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "tomato-toast-instruction-2",
      "step_number": 2,
      "instruction_ta": "தக்காளியை பெரிய துண்டுகளாக நறுக்கி தண்ணீர் விடாமல் அரைத்து வடிகட்டி விதைகளை நீக்கவும்.",
      "instruction_en": "Cut the tomatoes into large pieces, grind without adding water, strain, and discard the seeds.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "tomato-toast-instruction-3",
      "step_number": 3,
      "instruction_ta": "இதோடு வெங்காயம், கொத்தமல்லி, சர்க்கரை, உப்பு, மிளகாய்த் தூள், கரம்மசாலாத் தூள் சேர்த்து கலக்கவும்.",
      "instruction_en": "Mix in the onion, coriander, sugar, salt, chili powder, and garam masala powder.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "tomato-toast-instruction-4",
      "step_number": 4,
      "instruction_ta": "ஒரு மெல்லிய தோசைக் கல்லைக் காய வைத்து ஒரு ரொட்டித் துண்டை அதன் மேல் போடவும்.",
      "instruction_en": "Heat a thin griddle and place a bread slice on it.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "tomato-toast-instruction-5",
      "step_number": 5,
      "instruction_ta": "கீழ்ப்பாகம் லேசாகச் சுட்டவுடன் திருப்பிப் போட்டு மேலே ஒரு டேபிள் ஸ்பூன் தக்காளிக் கலவையை பரப்பவும்.",
      "instruction_en": "Once the bottom is lightly toasted, flip and spread a tablespoon of the tomato mixture on top.",
      "image_url": null,
      "display_order": 5
    },
    {
      "id": "tomato-toast-instruction-6",
      "step_number": 6,
      "instruction_ta": "சுற்றிலும் சிறிது எண்ணெய் விட்டுச் சுடவும்.",
      "instruction_en": "Drizzle a little oil around the edges and toast.",
      "image_url": null,
      "display_order": 6
    },
    {
      "id": "tomato-toast-instruction-7",
      "step_number": 7,
      "instruction_ta": "திருப்பிப் போட்டு மேலும் சிறிது எண்ணெய்விட்டு ஒரு நிமிடம் சுட்டு உடனே பரிமாறவும்.",
      "instruction_en": "Flip again, add a little more oil, toast for a minute, and serve right away.",
      "image_url": null,
      "display_order": 7
    }
  ]
}
