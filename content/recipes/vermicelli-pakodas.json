  "instructions": [
    {
      "id": "vermicelli-pakodas-instruction-1",
      "step_number": 1,
      "instruction_ta": "வெங்காயத்தையும், பச்சை மிளகாயையும் மெலிதாக நீளவாக்கில் அரியவும்.",
      "instruction_en": "Slice the onion and green chili thin, lengthwise.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "vermicelli-pakodas-instruction-2",
      "step_number": 2,
      "instruction_ta": "சேமியாவை சிறிது நெய் பூசி பொன்னிறமாக வறுக்கவும்.",
      "instruction_en": "Brush the vermicelli lightly with ghee and roast until golden.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "vermicelli-pakodas-instruction-3",
      "step_number": 3,
      "instruction_ta": "வறுத்த சேமியாவின் மேல் கொதிக்கும் தண்ணீர் ஊற்றி உடனே வடித்துவிடவும். மேலும் கொஞ்சம் பச்சை தண்ணீரை ஊற்றி வடிதட்டின் உதவியால் வடிகட்டவும்.",
      "instruction_en": "Pour boiling water over the roasted vermicelli and drain it immediately. Rinse with a little more cold water and drain again on a rack.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "vermicelli-pakodas-instruction-4",
      "step_number": 4,
      "instruction_ta": "உருளைக்கிழங்கை நன்றாக மசித்துக்கொண்டு அதோடு சேமியாவையும் மற்ற குறிப்பிடப்பட்ட பொருட்களையும் சேர்த்து கலந்து கொள்ளவும். இதோடு ஒரு டேபிள் ஸ்பூன் சூடான எண்ணெய் விட்டுக் கலக்கவும்.",
      "instruction_en": "Mash the potato well, then mix in the vermicelli and the rest of the listed ingredients. Add a tablespoon of hot oil and mix in.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "vermicelli-pakodas-instruction-5",
      "step_number": 5,
      "instruction_ta": "மற்ற பக்கோடாக்களைப் போல சூடான எண்ணெயில் பொரித்து சூடாகப் பரிமாறவும்.",
      "instruction_en": "Deep-fry in hot oil like the other pakodas and serve hot.",
      "image_url": null,
      "display_order": 5
    }
  ]
}
