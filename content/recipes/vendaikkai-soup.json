  "instructions": [
    {
      "id": "vendaikkai-soup-instruction-1",
      "step_number": 1,
      "instruction_ta": "வாணலியில் எண்ணெய் ஊற்றி இலவங்கபட்டை, இலை, மிளகு, பச்சைமிளகாய், பெரிய வெங்காயம் சேர்த்து லேசாக வதக்கவும். பின்னர் மூன்று அங்குலமாக நறுக்கிய வெண்டைக்காயை சேர்த்து மிகவும் நன்றாக வதக்கவும். மூன்று டம்ளர் தண்ணீர் சேர்த்து வேக விடவும். மஞ்சள் தூள், தக்காளி, உப்பு சேர்த்து கலவையை நன்றாக கொதிக்க விடவும். வெண்டைக்காய் வெந்ததும், வேக வைத்து மசித்த பருப்பை இக்கலவையுடன் சேர்த்து நன்றாக கொதிக்க விட்டு இறக்கவும். கொத்தமல்லி இலை தூவி பரிமாறவும்.",
      "instruction_en": "Vaanaliyil ennai oorRi ilavangapattai, ilai, milagu, pachaimilagai, periya vengayam serthu lesaaga vathakkavum. PinnaR moonRu angulamaaga narukkiya vendaikkaiyai serthu migavum nanRaaga vathakkavum. MoonRu dumbler thanneer serthu vega vidavum. Manjal thool, thakkali, uppu serthu kalavaiyai nanRaaga kothikka vidavum. Vendaikkai venthathum, vega vaithu masitha paruppai ikkalavaiyudan serthu nanRaaga kothikka vittu irakkavum. Kothamalli ilai thoovi parimaaravum.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "vendaikkai-soup-instruction-2",
      "step_number": 2,
      "instruction_ta": "குறிப்பு: வெண்டைக்காயை வதக்கும் போது 1 ஸ்பூன் எலுமிச்சம் சாறு சேர்த்தால் சீக்கிரம் வதங்கி விடும். நூல்நூலாக வராது.",
      "instruction_en": "KuRippu: Vendaikkaiyai vathakkum pothu 1 spoon elumicham saaRu serthaal seekiram vathangi vidum. Noolnoolaaga varaathu.",
      "image_url": null,
      "display_order": 2
    }
  ]
}
