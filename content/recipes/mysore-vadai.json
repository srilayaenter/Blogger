  "instructions": [
    {
      "id": "mysore-vadai-instruction-1",
      "step_number": 1,
      "instruction_ta": "பருப்பு வகைகளை ஒன்றாகக் கலந்து முழுகும்வரை தண்ணீர் விட்டு 3 மணி நேரம் ஊற வைக்கவும்.",
      "instruction_en": "Mix the dals together, cover with water, and soak for 3 hours.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "mysore-vadai-instruction-2",
      "step_number": 2,
      "instruction_ta": "ஊறியதும் நீரை நன்றாக வடித்துவிட்டு கரகரப்பாக அரைக்கவும். உப்பு சேர்த்து கடைசியில் ஆட்டவும்.",
      "instruction_en": "Once soaked, drain the water well and grind coarsely. Add salt and mix in at the end.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "mysore-vadai-instruction-3",
      "step_number": 3,
      "instruction_ta": "குறிப்பிடப்பட்டுள்ள மற்ற பொருட்களைச் சேர்த்து கலக்கவும்.",
      "instruction_en": "Mix in the rest of the listed ingredients.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "mysore-vadai-instruction-4",
      "step_number": 4,
      "instruction_ta": "எலுமிச்சையளவு உருண்டைகள் செய்து, வடை போல தட்டி சூடான எண்ணெயில் பொரித்தெடுக்கவும்.",
      "instruction_en": "Shape lemon-sized balls, flatten like a vadai, and deep-fry in hot oil.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "mysore-vadai-instruction-5",
      "step_number": 5,
      "instruction_ta": "சூடாக ஏதாவது தொக்கு அல்லது சாஸுடன் பரிமாறவும்.",
      "instruction_en": "Serve hot with some thokku or sauce.",
      "image_url": null,
      "display_order": 5
    }
  ]
