  "instructions": [
    {
      "id": "carrot-rissoles-instruction-1",
      "step_number": 1,
      "instruction_ta": "முழு கேரட்டை ஆவியில் வேகவைத்து மசித்துக் கொள்ளவும். வெங்காயம், குடமிளகாயை மிகப் பொடியாக அரியவும்.",
      "instruction_en": "Steam the whole carrot and mash it. Finely chop the onion and capsicum.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "carrot-rissoles-instruction-2",
      "step_number": 2,
      "instruction_ta": "வாணலியில் சிறிது எண்ணெய் விட்டுச் சூடாக்கி வெங்காயம், குடமிளகாயை சில நிமிடங்கள் வதக்கவும். அடுப்பிலிருந்து இறக்கி, நன்றாகப் பிசைந்த சாதத்துடன் கலந்து, மசித்த கேரட், பாதி பிரட் தூள், மற்ற பொடி வகைகளைச் சேர்க்கவும்.",
      "instruction_en": "Heat a little oil in a pan and saute the onion and capsicum for a few minutes. Remove from heat, mix with well-mashed rice, the mashed carrot, half the bread crumbs, and the remaining powdered spices.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "carrot-rissoles-instruction-3",
      "step_number": 3,
      "instruction_ta": "கைகளால் சப்பாத்தி மாவு போல கெட்டியாக கலக்கவும். எலுமிச்சை அளவு உருண்டைகளாக உருட்டவும்.",
      "instruction_en": "Mix by hand into a firm consistency, like chapati dough. Shape into lemon-sized balls.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "carrot-rissoles-instruction-4",
      "step_number": 4,
      "instruction_ta": "பிரட் தூளில் புரட்டி, மைதா குழைத்த கலவையில் முக்கி எடுத்து, மற்றொரு முறை பிரட் தூளில் புரட்டி எடுக்கவும். விருப்பப்பட்டால் நீளவாக்கில் உருட்டவும். ஒரு தட்டில் அடுக்கி 1 மணி நேரம் ஃப்ரிஜ்ஜில் வைக்கவும்.",
      "instruction_en": "Roll in bread crumbs, dip in the maida-cornflour paste, then roll in bread crumbs once more. Shape into an oval if you like. Arrange on a plate and refrigerate for 1 hour.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "carrot-rissoles-instruction-5",
      "step_number": 5,
      "instruction_ta": "பொரிப்பதற்கு முன்னெடுத்து சூடான எண்ணெயில் பொன்னிறமாகப் பொரிக்கவும். சூடாக தக்காளி சாஸுடன் பரிமாறவும்.",
      "instruction_en": "Take out just before frying and deep-fry in hot oil until golden brown. Serve hot with tomato sauce.",
      "image_url": null,
      "display_order": 5
    }
  ]
}
