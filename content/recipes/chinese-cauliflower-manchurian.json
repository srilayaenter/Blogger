  "instructions": [
    {
      "id": "chinese-cauliflower-manchurian-instruction-1",
      "step_number": 1,
      "instruction_ta": "காலிப்ளவரை சிறிய பூக்களாகப் பிரித்தெடுக்கவும். கொதிக்கும் சூடு உள்ள தண்ணீரில் உப்பு சேர்த்து கழுவிய காலிப்ளவர் துண்டங்களை இரண்டு நிமிடம் போட்டு மூடி வைக்கவும்.",
      "instruction_en": "Break the cauliflower into small florets. Add salt to boiling water, drop in the washed florets, and cover for two minutes.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "chinese-cauliflower-manchurian-instruction-2",
      "step_number": 2,
      "instruction_ta": "தண்ணீரை நன்கு வடித்துவிட்டு துணியின் மேல்பரப்பி மீதி தண்ணீரை உறிஞ்சும்படி வைக்கவும்.",
      "instruction_en": "Drain thoroughly and spread on a cloth to blot up the remaining water.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "chinese-cauliflower-manchurian-instruction-3",
      "step_number": 3,
      "instruction_ta": "அரைத்த விழுதோடு உப்பு, வெள்ளை மிளகுத் தூள், சாஸ் வகைகளைக் கலந்து இதை காலிப்ளவர் துண்டங்களின் மேல் நன்றாகப் பூசி 1/2 மணி நேரம் ஊற வைக்கவும்.",
      "instruction_en": "Mix the ground paste with salt, white pepper powder, and the sauces, coat the cauliflower florets well with this, and let marinate for 1/2 hour.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "chinese-cauliflower-manchurian-instruction-4",
      "step_number": 4,
      "instruction_ta": "பொரிப்பதற்கு முன் இதில் மக்காச்சோளமாவைத் தூவி சூடான எண்ணெயில் பொரித்து சூடாகப் பரிமாறவும்.",
      "instruction_en": "Just before frying, dust with corn flour and deep-fry in hot oil. Serve hot.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "chinese-cauliflower-manchurian-instruction-5",
      "step_number": 5,
      "instruction_ta": "மாற்று செய்முறை: இதே போல பலவித காய்கறிகளைக் கலந்தும் செய்யலாம் (கேரட், உருளைக்கிழங்கு, குடமிளகாய், கோஸ் போன்ற காய்கறிகளை உபயோகப்படுத்தவும்).",
      "instruction_en": "Alternative method: this can also be made with a mix of other vegetables -- carrot, potato, capsicum, and cabbage all work well.",
      "image_url": null,
      "display_order": 5
    }
  ]
