  "instructions": [
    {
      "id": "masala-pori-1-instruction-1",
      "step_number": 1,
      "instruction_ta": "ஒரு அகலமான பேசினில் பொட்டுக்கடலை, பொரியை எடுத்துக்கொண்டு, கைகளால் சிறிதளவு எண்ணெய் விட்டு பிசறவும்.",
      "instruction_en": "Take the roasted gram and puffed rice in a wide basin and rub in a little oil by hand.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "masala-pori-1-instruction-2",
      "step_number": 2,
      "instruction_ta": "எண்ணெய் அதோடு ஒட்டிக் கொண்டதும், உப்பு, மிளகாய்த் தூள் தூவவும்.",
      "instruction_en": "Once the oil coats them evenly, dust in the salt and chili powder.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "masala-pori-1-instruction-3",
      "step_number": 3,
      "instruction_ta": "குறிப்பிடப் பட்டுள்ள காய்கறிகளைச் சேர்த்து சீக்கிரமாகக் கலந்து காரம் பற்றாவிடில் இன்னும் கொஞ்சம் சேர்த்து எலுமிச்சை சாறு பிழிந்து மேலே ஓமப்பொடி தூவி உடனே பரிமாறவும்.",
      "instruction_en": "Add the listed vegetables and mix quickly. If it's not spicy enough, add a little more chili powder, squeeze in the lemon juice, sprinkle sev on top, and serve immediately.",
      "image_url": null,
      "display_order": 3
    }
  ]
}
