  "instructions": [
    {
      "id": "kathirikkai-kothsu-instruction-1",
      "step_number": 1,
      "instruction_ta": "கத்தரிக்காயை சிறு துண்டுகளாக நறுக்கி, உப்பு மஞ்சள் தூள் மிளகாய் நறுக்கி போட்டு வேக வைத்து கடைந்து கொள்ளவும். புளியைக் கரைந்து, கரைசலில் குழம்புப் போட்டு சேர்த்து காயில் ஊற்றி இறக்கவும்.",
      "instruction_en": "Cut the brinjal into small pieces and cook with salt, turmeric powder and chopped chillies, then mash well. Dissolve the tamarind in water, mix in the kuzhambu powder, pour this into the cooked brinjal, and remove from heat.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "kathirikkai-kothsu-instruction-2",
      "step_number": 2,
      "instruction_ta": "குறிப்பு: கத்தரிக்காயை தணலில் போட்டு சுட்டு தோலுரித்து பிசைந்தும் செய்யலாம்.",
      "instruction_en": "Note: You can also roast the brinjal over embers, peel off the skin, and mash it this way.",
      "image_url": null,
      "display_order": 2
    }
  ]
