    {
      "id": "coriander-chutney-sandwiches-instruction-1",
      "step_number": 1,
      "instruction_ta": "வாணலியில் எண்ணெய் விட்டுச் சூடாக்கி சிகப்பு மிளகாய், தக்காளி சேர்த்து வதக்கவும்.",
      "instruction_en": "Heat oil in a pan and saute the dried chili and tomato.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "coriander-chutney-sandwiches-instruction-2",
      "step_number": 2,
      "instruction_ta": "கடைசியில் கொத்தமல்லி, கறிவேப்பிலை சேர்த்துக் கலந்து ஒரு நிமிடம் வதக்கி இறக்கவும்.",
      "instruction_en": "Finally add the coriander and curry leaves, mix, saute for a minute, and remove from heat.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "coriander-chutney-sandwiches-instruction-3",
      "step_number": 3,
      "instruction_ta": "ஆறியபின், உப்பு, புளி சேர்த்து கெட்டியான சட்னியாக அரைக்கவும்.",
      "instruction_en": "Once cooled, add salt and tamarind, and grind into a thick chutney.",
      "image_url": null,
      "display_order": 3
    },
    {
