  "instructions": [
    {
      "id": "chat-masala-powder-instruction-1",
      "step_number": 1,
      "instruction_ta": "சிகப்பு மிளகாய், தனியா மற்றும் மசாலா சாமான்களை வெயிலில் நன்கு காயவைக்கவும்.",
      "instruction_en": "Sun-dry the dried red chili, coriander seeds, and other spices thoroughly.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "chat-masala-powder-instruction-2",
      "step_number": 2,
      "instruction_ta": "காய்ந்த பிறகு எல்லாவற்றையும் ஒன்றாகப் பொடி செய்து பாட்டிலில் வைக்கவும் (தேவைப்படும் போது குறிப்பிடப்பட்டுள்ள செய்முறைக் குறிப்பில் உள்ளபடி உபயோகிக்கவும்).",
      "instruction_en": "Once dried, grind everything together into a powder and store in a jar (use as directed in whichever recipe calls for it).",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "chat-masala-powder-instruction-3",
      "step_number": 3,
      "instruction_ta": "குறிப்பு: காய்ந்த புதினா இலையையும் பொடி செய்து கலந்து உபயோகப்படுத்தலாம்.",
      "instruction_en": "Note: dried, powdered mint leaves can also be mixed in and used.",
      "image_url": null,
      "display_order": 3
    }
  ]
