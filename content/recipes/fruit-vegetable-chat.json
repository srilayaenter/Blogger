  "instructions": [
    {
      "id": "fruit-vegetable-chat-instruction-1",
      "step_number": 1,
      "instruction_ta": "காய்கறிகளையும், பழங்களையும் ஒரே அளவு துண்டங்களாக்கவும்.",
      "instruction_en": "Cut the vegetables and fruits into evenly sized pieces.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "fruit-vegetable-chat-instruction-2",
      "step_number": 2,
      "instruction_ta": "உப்பு, மிளகுத் தூள் சேர்த்து எலுமிச்சை சாறு பிழிந்து, சாட் மசாலா பொடி தூவி லேசாக் குலுக்கி விடவும்.",
      "instruction_en": "Add salt and pepper powder, squeeze in the lemon juice, sprinkle in the chat masala powder, and toss lightly.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "fruit-vegetable-chat-instruction-3",
      "step_number": 3,
      "instruction_ta": "மூடியால் மூடி 1/2 மணி நேரம் ப்ரிஜ்ஜில் வைக்கவும்.",
      "instruction_en": "Cover with a lid and refrigerate for 1/2 hour.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "fruit-vegetable-chat-instruction-4",
      "step_number": 4,
      "instruction_ta": "பரிமாறுமுன் ஒரு அலங்காரமான கிண்ணத்தில் போட்டு மேலே கொத்தமல்லித் தழை தூவி கடைந்த பாலேடு அலங்கரித்து பரிமாறவும்.",
      "instruction_en": "Before serving, put it in a decorative bowl, sprinkle coriander leaves on top, garnish with whipped cream, and serve.",
      "image_url": null,
      "display_order": 4
