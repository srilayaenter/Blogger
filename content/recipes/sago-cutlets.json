  "instructions": [
    {
      "id": "sago-cutlets-instruction-1",
      "step_number": 1,
      "instruction_ta": "உருளைக்கிழங்கை வேகவைத்து, தோலுரித்து கட்டியில்லாமல் நன்றாக மசிக்கவும். ஜவ்வரிசியைக் கழுவி முழுகும்வரை தண்ணீர் விட்டு 1 மணி நேரம் ஊற வைக்கவும் (அளவில் பெரிய ஜவ்வரிசியாக இருந்தால் அதிக நேரம் ஊற வைக்கவும்).",
      "instruction_en": "Boil the potatoes, peel, and mash smooth with no lumps. Wash the sago, cover with water, and soak for 1 hour (soak longer if the sago pearls are large).",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "sago-cutlets-instruction-2",
      "step_number": 2,
      "instruction_ta": "வாணலியில் எண்ணெய்விட்டு சூடானதும் சோம்பு தாளித்து, அரைத்த விழுதைச் சேர்க்கவும். ஒரு நிமிடம் வதக்கியதும் வெங்காயம் சேர்த்து சிவக்க வதக்கவும்.",
      "instruction_en": "Heat oil in a pan, temper fennel seeds, and add the ground paste. Saute for a minute, then add the onion and saute until reddish.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "sago-cutlets-instruction-3",
      "step_number": 3,
      "instruction_ta": "கடைசியில் மசித்த உருளைக்கிழங்கைச் சேர்த்து 3 நிமிடங்கள் வதக்கி உப்பு, கரம்மசாலாத் தூள், மிளகாய்த் தூள் சேர்த்து கலக்கவும். அடுப்பிலிருந்து இறக்கி ஆற வைக்கவும்.",
      "instruction_en": "Finally add the mashed potato and saute for 3 minutes, then mix in salt, garam masala powder, and chili powder. Remove from heat and let cool.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "sago-cutlets-instruction-4",
      "step_number": 4,
      "instruction_ta": "ரொட்டித் துண்டங்களை ஒவ்வொன்றாகத் தண்ணீரில் முக்கி கெட்டியாகப் பிழிந்து உருளைக்கிழங்கு கலவையில் சேர்க்கவும். ஊறிய ஜவ்வரிசியை உதிர்த்துவிட்டு உருளைக்கிழங்கோடு சேர்க்கவும். பாதி ரொட்டித் தூள் மற்றும் வேர்க்கடலைப் பொடியையும் சேர்க்கவும்.",
      "instruction_en": "Dip each bread slice in water, squeeze out firmly, and mix into the potato mixture. Drain and fluff the soaked sago and mix it in too, along with half the bread crumbs and the peanut powder.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "sago-cutlets-instruction-5",
      "step_number": 5,
      "instruction_ta": "கட்லெட் போல செய்து மீதி ரொட்டித் தூளில் புரட்டி எடுத்து தோசைக்கல்லில் அதிக எண்ணெய் விட்டு இரண்டு பக்கமும் சிவக்க சுட்டு எடுக்கவும். சூடாக தக்காளி சாஸ் மற்றும் புதினா சட்னியுடன் பரிமாறவும்.",
      "instruction_en": "Shape into cutlets and roll in the remaining bread crumbs. Cook on a griddle with plenty of oil on both sides until browned. Serve hot with tomato sauce and mint chutney.",
      "image_url": null,
      "display_order": 5
    }
  ]
}
