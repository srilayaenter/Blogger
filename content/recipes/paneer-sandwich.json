  "instructions": [
    {
      "id": "paneer-sandwich-instruction-1",
      "step_number": 1,
      "instruction_ta": "பாலாடைக்கட்டியை (பனீர்) நன்றாக உதிர்த்துவிட்டு அதோடு மைதா, முளைப்பயறு, சாஸ் வகைகள், பொடி வகைகள் சேர்த்து கலக்கவும்.",
      "instruction_en": "Crumble the paneer thoroughly and mix in the maida, sprouted moong, the sauces, and the powdered spices.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "paneer-sandwich-instruction-2",
      "step_number": 2,
      "instruction_ta": "ரொட்டித் துண்டுகளின மேல் வெண்ணெய் தடவவும்.",
      "instruction_en": "Butter the bread slices.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "paneer-sandwich-instruction-3",
      "step_number": 3,
      "instruction_ta": "பாலாடைக்கட்டி கலவையை இரண்டு ரொட்டித் துண்டுகள் மத்தியில் வைத்து சாண்ட்விட்ச் டோஸ்டரில் வைத்து சுடவும்.",
      "instruction_en": "Place the paneer mixture between two bread slices and toast in a sandwich toaster.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "paneer-sandwich-instruction-4",
      "step_number": 4,
      "instruction_ta": "குறிப்பு: இதே கலவையை ஒரு ஸ்லைஸ் மீது சிறிது வைத்து மேலே மெலிதாக சீவப்பட்ட குடமிளகாய் வைத்து துருவிய சீஸ் தூவி ஓவனில் வைத்து (Grill) பேக் செய்யலாம்.",
      "instruction_en": "Note: the same mixture can be spread on one slice, topped with thinly sliced capsicum and grated cheese, and grilled in the oven instead.",
      "image_url": null,
      "display_order": 4
    }
  ]
