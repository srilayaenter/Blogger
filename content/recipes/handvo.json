  "instructions": [
    {
      "id": "handvo-instruction-1",
      "step_number": 1,
      "instruction_ta": "அரிசி மாவு, கடலைமாவோடு பொடித்த பொட்டுக்கடலை, எள்ளு, தனியா, உப்பு சேர்த்து மோரில் கலந்து 10 மணி நேரம் மூடி வைக்கவும்.",
      "instruction_en": "Mix the rice flour and gram flour with the ground roasted gram, sesame seeds, coriander seeds, and salt into the buttermilk, and cover and rest for 10 hours.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "handvo-instruction-2",
      "step_number": 2,
      "instruction_ta": "சுடுவதற்கு முன் அரைத்த விழுது, சோடா, கொத்தமல்லி, பெருங்காயம் சேர்த்து எண்ணெயில் கடுகு, கறிவேப்பிலை தாளித்துக் கொட்டி நன்றாகக் கலக்கவும்.",
      "instruction_en": "Just before cooking, mix in the ground paste, soda, coriander leaves, and asafoetida, and pour in a mustard-and-curry-leaf tempering, mixing well.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "handvo-instruction-3",
      "step_number": 3,
      "instruction_ta": "ஒரு அகலமான வாணலியை எடுத்துக் கொண்டு 1½ டேபிள் ஸ்பூன் எண்ணெய் விட்டுச் சூடாக்கவும். வாணலிக்குத் தகுந்தபடி 1/4 அங்குல கனத்திற்கு கலந்த மாவை ஊற்றி மூடியால் மூடி குறைந்த அனலில் வைக்கவும்.",
      "instruction_en": "Heat 1½ tablespoons of oil in a wide pan. Pour in the batter to a thickness of 1/4 inch, filling the pan, cover with a lid, and cook on low heat.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "handvo-instruction-4",
      "step_number": 4,
      "instruction_ta": "மேல் பாகம் பச்சைமாவு இல்லாமல் வெந்து இருக்கும்போது மெதுவாகத் திருப்பிப் போட்டு மேலும் எண்ணெய் விடவும். இருபுறமும் நன்கு சிவந்து உள்ளே உள்ள மாவு நன்கு வெந்ததும் எடுக்கவும்.",
      "instruction_en": "Once the top is no longer raw, flip gently and add a little more oil. Once both sides are well browned and the inside is fully cooked, remove from the pan.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "handvo-instruction-5",
      "step_number": 5,
      "instruction_ta": "சதுரத் துண்டங்களாக அரிந்து பரிமாறவும். குறிப்பு: இதையே ஓவனிலும் பேக் செய்யலாம்.",
      "instruction_en": "Cut into squares and serve. Note: this can also be baked in an oven.",
      "image_url": null,
      "display_order": 5
    }
  ]
}
