  "instructions": [
    {
      "id": "potato-roll-instruction-1",
      "step_number": 1,
      "instruction_ta": "மைதா, ரவை, எண்ணெய், உப்பு ஒன்றாகக் கலந்து ஒரு அகலக் கிண்ணத்தில் வைக்கவும். தேவைப்பட்ட தண்ணீர் சேர்த்து சப்பாத்தி மாவு போல கெட்டியாகப் பிசையவும். ஈரத்துணி கொண்டு மூடி வைக்கவும்.",
      "instruction_en": "Mix the maida, rava, oil, and salt together in a wide bowl. Add water as needed and knead into a stiff chapati-like dough. Cover with a damp cloth.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "potato-roll-instruction-2",
      "step_number": 2,
      "instruction_ta": "உருளைக்கிழங்கை வேக வைத்து, தோலுரித்து உதிர்த்துக் கொள்ளவும். இதோடு மற்ற குறிப்பிடப்பட்ட பொருட்களைச் சேர்த்து கலந்து வைக்கவும் (வதக்க வேண்டாம்).",
      "instruction_en": "Boil the potato, peel, and crumble it. Mix in the remaining listed ingredients (no need to saute).",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "potato-roll-instruction-3",
      "step_number": 3,
      "instruction_ta": "இக் கலவையை எலுமிச்சையளவு உருண்டைகளாகச் செய்து பிறகு நீளவாக்கில் உருட்டவும் (நீள ஜாமூன் போல).",
      "instruction_en": "Shape the mixture into lemon-sized balls, then roll each into a long log (like an oblong gulab jamun).",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "potato-roll-instruction-4",
      "step_number": 4,
      "instruction_ta": "பிசைந்த சப்பாத்தி மாவிலிருந்து சிறிய உருண்டைகள் செய்து சப்பாத்தி போல இடவும். இதில் ஒரு மூலையில் மசாலா உருட்டியதை வைத்து பாய் போல சுருட்டவும். குழல் போல சுருட்டியதும் ஓரங்களை உள்ளே மடித்து மைதா பசை கொண்டு ஒட்டவும். பிரிந்து வராமல் எல்லா பக்கங்களையும் சரியாக ஒட்டவும்.",
      "instruction_en": "Make small balls from the kneaded dough and roll each out like a chapati. Place a potato log at one edge and roll it up like a mat into a tube. Fold in the open ends and seal with the maida paste, sealing all sides securely so nothing leaks out.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "potato-roll-instruction-5",
      "step_number": 5,
      "instruction_ta": "இதே போல மாவு முழுவதையும் செய்துகொண்டு ஈரத்துணி கொண்டு மூடி வைக்கவும். ஒரு தடவைக்கு 4 அல்லது 5 சுருள்களை மிதமான சூட்டில் எண்ணெயில் பொன்னிறமாகப் பொரித்தெடுக்கவும். மூன்று (அ) நான்கு துண்டங்களாக, கூரான கத்தி கொண்டு வெட்டி தக்காளி சாஸுடன் பரிமாறவும்.",
      "instruction_en": "Shape all the dough this way and cover with a damp cloth. Deep-fry 4-5 rolls at a time in moderately hot oil until golden. Slice each into 3 or 4 pieces with a sharp knife and serve with tomato sauce.",
      "image_url": null,
      "display_order": 5
    }
  ]
}
