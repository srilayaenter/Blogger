  "instructions": [
    {
      "id": "potato-cheese-croquettes-instruction-1",
      "step_number": 1,
      "instruction_ta": "உருளைக்கிழங்கை வேகவைத்து தோலுரித்து சூடாக இருக்கும்போதே மசித்துக் கொள்ளவும்.",
      "instruction_en": "Boil the potatoes, peel, and mash while still hot.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "potato-cheese-croquettes-instruction-2",
      "step_number": 2,
      "instruction_ta": "அதோடு துருவிய சீஸ், நறுக்கிய வெங்காயம், உப்பு, மிளகாய் விழுது, மிளகாய்த் தூள் சேர்த்து கலக்கவும்.",
      "instruction_en": "Mix in the grated cheese, chopped onion, salt, chopped green chili, and chili powder.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "potato-cheese-croquettes-instruction-3",
      "step_number": 3,
      "instruction_ta": "கடைசியில் பாதி மக்காச்சோள மாவு, ரொட்டித் தூள் சேர்த்து பிசையவும். மாவிலிருந்து எலுமிச்சையளவு உருண்டைகள் செய்து வடை போல தட்டவும்.",
      "instruction_en": "Finally knead in half the corn flour and half the bread crumbs. Shape into lemon-sized balls and flatten each like a vadai.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "potato-cheese-croquettes-instruction-4",
      "step_number": 4,
      "instruction_ta": "மீதி இருக்கும் மக்காச்சோள மாவில் தண்ணீர் சேர்த்து கூழ் போல கலக்கவும். தட்டிய உருளைக்கிழங்கு கட்லெட்டை சோள மாவுக் கலவையில் முக்கி பிரட்தூளில் புரட்டி எடுக்கவும்.",
      "instruction_en": "Mix the remaining corn flour with water into a thin batter. Dip each flattened potato patty in this batter, then roll in the remaining bread crumbs.",
      "image_url": null,
      "display_order": 4
    },
    {
      "id": "potato-cheese-croquettes-instruction-5",
      "step_number": 5,
      "instruction_ta": "சூடான எண்ணெயில் பொன்னிறமாகப் பொரித்து தக்காளி சாஸுடன் பரிமாறவும்.",
      "instruction_en": "Deep-fry in hot oil until golden and serve with tomato sauce.",
      "image_url": null,
      "display_order": 5
    }
  ]
