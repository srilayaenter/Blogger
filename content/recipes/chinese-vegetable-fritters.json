  "instructions": [
    {
      "id": "chinese-vegetable-fritters-instruction-1",
      "step_number": 1,
      "instruction_ta": "வெங்காயத்தையும், குடமிளகாயையும் மெல்லிய வட்ட வடிவ துண்டங்களாக்கவும். கேரட், கோஸ் இரண்டையும் தீக்குச்சிகளைப் போல நறுக்கிக் கொள்ளவும்.",
      "instruction_en": "Cut the onion and capsicum into thin rounds. Cut the carrot and cabbage into matchstick strips.",
      "image_url": null,
      "display_order": 1
    },
    {
      "id": "chinese-vegetable-fritters-instruction-2",
      "step_number": 2,
      "instruction_ta": "அரிந்த காய்கறிகள் எல்லாவற்றையும் ஐஸ் போட்ட தண்ணீரில் 1/2 மணி நேரம் போட்டு வைக்கவும் (காய்கறிகள் இதனால் சிறிது கெட்டிப்படும்). தண்ணீரிலிருந்து காய்கறிகளைப் பிழிந்து எடுத்து ஒரு துணியின் மேல் பரப்பி தண்ணீரைத் துடைத்து எடுக்கவும்.",
      "instruction_en": "Soak all the cut vegetables in ice water for 1/2 hour (this makes them crisper). Squeeze the vegetables out of the water and spread on a cloth to blot dry.",
      "image_url": null,
      "display_order": 2
    },
    {
      "id": "chinese-vegetable-fritters-instruction-3",
      "step_number": 3,
      "instruction_ta": "துடைத்தபின் ஒரு தட்டின் மேல் பரப்பி அதோடு உப்பு, மிளகாய்த் தூள், சீன உப்பு, சாஸ் வகைகள் சேர்த்து கலந்து 10 நிமிடம் அப்படியே வைக்கவும்.",
      "instruction_en": "Spread on a plate, mix in salt, chili powder, ajinomoto, and the sauces, and let it sit for 10 minutes.",
      "image_url": null,
      "display_order": 3
    },
    {
      "id": "chinese-vegetable-fritters-instruction-4",
      "step_number": 4,
      "instruction_ta": "ஊறியபின் மாவு வகைகளையும், காய்ந்த ரொட்டித் தூளையும் தூவி கலந்து சூடான எண்ணெயில் பிடிக்கும்வரை கைகளால் பிசறி விடவும் (பகோடா போடுவது போல). மொறு மொறுவென்று பொரிந்ததும் சல்லடைக் கரண்டியால் எடுத்து எண்ணெயை நன்கு வடிய விட்டு சூடாகப் பரிமாறவும்.",
      "instruction_en": "Once marinated, dust in the flours and dried bread crumbs, mix, and squeeze small handfuls into hot oil the way you would drop pakoda batter. Once fried crisp, lift out with a slotted spoon, drain well, and serve hot.",
      "image_url": null,
      "display_order": 4
    }
  ]
}
